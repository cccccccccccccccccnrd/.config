yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config layout bsp

yabai -m config window_placement second_child

yabai -m config top_padding 5
yabai -m config bottom_padding 5
yabai -m config left_padding 5
yabai -m config right_padding 5
yabai -m config window_gap 5

# yabai -m config mouse_follows_focus on

# yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

yabai -m config mouse_drop_action swap

yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Finder$" manage=off sub-layer=below
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^CleanShot X$" manage=off
yabai -m rule --add app="^Preview$" manage=off
yabai -m rule --add app="^Docker Desktop$" manage=off
yabai -m rule --add app="^DevUtils$" manage=off
yabai -m rule --add app="^FaceTime$" manage=off
yabai -m rule --add app="^overlay$" manage=off

# Subtle active-window border via JankyBorders.
# 0x33ffffff = white at ~20% opacity. Install with:
#   brew tap FelixKratz/formulae && brew install borders
if [ -x /opt/homebrew/bin/borders ]; then
  /opt/homebrew/bin/borders active_color=0x33ffffff inactive_color=0x00000000 width=11.0 style=round hidpi=on &
fi