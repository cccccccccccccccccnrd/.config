# Space focus starts on the German ^ key, then 1, 2, 3...
alt - 0x0A : yabai -m space --focus 1
alt - 1 : yabai -m space --focus 2
alt - 2 : yabai -m space --focus 3
alt - 3 : yabai -m space --focus 4
alt - 4 : yabai -m space --focus 5

alt - left : yabai -m space --focus prev
alt - right : yabai -m space --focus next

alt - tab : yabai -m window --focus stack.next
# CapsLock is remapped to left_control in Karabiner, so CapsLock+Alt+Tab is ctrl+alt+tab here.
ctrl + alt - tab : yabai -m window --focus stack.prev

alt + shift - down : yabai -m window --swap south
alt + shift - up : yabai -m window --swap north
alt + shift - left : yabai -m window --swap west
alt + shift - right : yabai -m window --swap east

alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5
alt + shift - 6 : yabai -m window --space 6
# alt + shift - 7 : yabai -m window --space 7
alt + shift - 8 : yabai -m window --space 8
alt + shift - 9 : yabai -m window --space 9

alt - space : yabai -m window --toggle float
alt - r : yabai -m space --rotate 270
alt - e : yabai -m space --balance
alt - d : yabai -m window --toggle split
# alt - y : yabai -m space --mirror y-axis
# alt - x : yabai -m space --mirror x-axis

alt - return : $HOME/.config/scripts/open-on-cursor-display.sh open -na "Ghostty"
# Option+Shift+Enter is handled by Ghostty as a global quick terminal keybind.
# alt + shift - return : $HOME/.config/yabai/scripts/open_ghostty_pi.sh
# option + , applies a random Ghostty theme to the focused Ghostty terminal
alt - 0x2B : $HOME/.config/scripts/ghostty-focused-random-theme.sh
alt - 0x32 : $HOME/.config/scripts/open-last-finder-location.sh
alt - y : $HOME/.config/scripts/open-on-cursor-display.sh open -n -a "Firefox"
alt - x : $HOME/.config/scripts/open-on-cursor-display.sh code -n
alt - c : $HOME/.config/scripts/open-on-cursor-display.sh open -na "Obsidian"

ctrl - left : yabai -m window west --resize right:-300:0 2> /dev/null || yabai -m window --resize right:-300:0
ctrl - down : yabai -m window north --resize bottom:0:300 2> /dev/null || yabai -m window --resize bottom:0:300
ctrl - up : yabai -m window south --resize top:0:-300 2> /dev/null || yabai -m window --resize top:0:-300
ctrl - right : yabai -m window east --resize left:300:0 2> /dev/null || yabai -m window --resize left:300:0